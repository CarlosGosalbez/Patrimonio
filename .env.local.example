# =============================================================================
# PATRIMIO — Variables de Entorno (PLANTILLA)
# =============================================================================
# Copia este archivo como .env.local para desarrollo local:
#   cp .env.local.example .env.local
#
# ⚠️  NUNCA subas .env.local al repositorio. Ya está en .gitignore.
# ⚠️  Este archivo SÍ puede (y debe) estar en el repositorio — no contiene secretos.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  DÓNDE VIVE CADA SECRETO EN PRODUCCIÓN                                  │
# ├───────────────────────────┬─────────────────────────────────────────────┤
# │  Vercel Dashboard         │  NEXT_PUBLIC_SUPABASE_URL, ANON_KEY          │
# │  (Environment Variables)  │  RESEND_API_KEY, SENTRY_DSN, APP_URL        │
# ├───────────────────────────┬─────────────────────────────────────────────┤
# │  Supabase Edge Function   │  SUPABASE_SERVICE_ROLE_KEY                  │
# │  Secrets                  │  ALPHA_VANTAGE_API_KEY, FMP_API_KEY,        │
# │                           │  VAPID_PRIVATE_KEY, CRON_SECRET             │
# ├───────────────────────────┬─────────────────────────────────────────────┤
# │  .env.local únicamente    │  ⚠ Bootstrap/Admin: DATABASE_URL,           │
# │  (eliminar tras setup)    │  SUPABASE_ACCESS_TOKEN, DB_PASSWORD         │
# └───────────────────────────┴─────────────────────────────────────────────┘
# =============================================================================

# =============================================================================
# SUPABASE — Runtime (obligatorios siempre en Next.js)
# =============================================================================
# Obtener en: Supabase Dashboard → Project Settings → API

# URL pública del proyecto (formato: https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anónima — segura para el cliente (RLS la protege)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here


# =============================================================================
# SUPABASE — Bootstrap/Admin ⚠ ELIMINAR TRAS EL SETUP INICIAL
# =============================================================================
# Solo para: supabase db push, supabase gen types, scripts de admin
# DESPUÉS del setup:
#   → SUPABASE_SERVICE_ROLE_KEY → Supabase Dashboard > Edge Functions > Secrets
#   → DATABASE_URL y SUPABASE_DB_PASSWORD → eliminar de .env.local

# Token de acceso personal (supabase CLI)
# Obtener en: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token-here

# Contraseña de la BD (solo para CLI y migraciones)
# Obtener en: Supabase → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=your-database-password-here

# URL de conexión directa a PostgreSQL
# Formato: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# JWT Secret — para verificar tokens en Edge Functions
# Obtener en: Supabase → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Service Role Key — SOLO para Edge Functions / scripts de admin
# ⚠ NUNCA expongas en NEXT_PUBLIC_* ni en código cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here


# =============================================================================
# APP URL — necesaria para WebAuthn (origin) y links en emails
# =============================================================================
# Desarrollo: http://localhost:3000
# Producción: https://tu-dominio.com

NEXT_PUBLIC_APP_URL=http://localhost:3000


# =============================================================================
# EMAIL — Resend (transaccional)
# =============================================================================
# Plan gratuito: 3.000 emails/mes
# Obtener clave: https://resend.com → API Keys
# Verificar dominio del remitente en Resend antes de usar en producción

RESEND_API_KEY=re_your-resend-api-key-here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Patrimio


# =============================================================================
# APIs DE COTIZACIONES — Solo usadas en Supabase Edge Functions (cron)
# =============================================================================
# El frontend NUNCA llama a estas APIs directamente.
# El Edge Function `market-updater` actualiza la tabla `market_cache`.
# Aquí solo para desarrollo local con `supabase functions serve`.

# Alpha Vantage — 25 req/día gratis: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Financial Modeling Prep — 250 req/día gratis: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=your-fmp-api-key

# Open Exchange Rates — 1.000 req/mes gratis: https://openexchangerates.org/signup/free
OPEN_EXCHANGE_RATES_APP_ID=your-open-exchange-rates-app-id

# CoinGecko — opcional, 30 req/min sin clave: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your-coingecko-api-key


# =============================================================================
# MONITOREO DE ERRORES — Sentry
# =============================================================================
# Plan gratuito: 5.000 errores/mes
# Obtener DSN: https://sentry.io → Project Settings → Client Keys (DSN)
# SENTRY_AUTH_TOKEN: Solo en CI/CD (para subir sourcemaps), NO en runtime

SENTRY_DSN=https://your-sentry-key@o0000000000000000.ingest.de.sentry.io/0000000000000000
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-key@o0000000000000000.ingest.de.sentry.io/0000000000000000
SENTRY_AUTH_TOKEN=sntryu_your-sentry-auth-token-here
SENTRY_ORG=your-sentry-org-id
SENTRY_PROJECT=patrimio


# =============================================================================
# PUSH NOTIFICATIONS — Web Push API (VAPID)
# =============================================================================
# Generar par de claves VAPID:
#   npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY → Supabase Edge Functions Secrets (nunca en client)

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-base64-here
VAPID_PRIVATE_KEY=your-vapid-private-key-base64-here


# =============================================================================
# SEGURIDAD — Cron jobs
# =============================================================================
# Secreto aleatorio para autenticar llamadas a /api/cron/*
# Generar con: openssl rand -hex 32

CRON_SECRET=your-random-cron-secret-here


# =============================================================================
# TESTING — Playwright E2E
# =============================================================================
# Solo necesario para ejecutar tests E2E localmente
# El usuario de test debe existir en tu proyecto de Supabase

TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your-test-user-password
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000


# =============================================================================
# DEVELOPMENT LOCAL — Supabase CLI (`supabase start`)
# =============================================================================
# Descomenta para usar la instancia local en vez de la nube:

# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqzCwbgYkp79PoGYbDH8JlTv7ULlGiRYU
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# NEXT_PUBLIC_APP_URL=http://localhost:3000
