# =============================================================================
# .gitignore — Patrimio
# =============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/

# ── Supabase local state (generated by `supabase start`) ─────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/seed.sql          # contains real data in some setups

# ── Environment variables — NEVER commit these ───────────────────────────────
.env
.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
playwright/.cache/

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ── OS / Editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.swp
*.swo
*~

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Sentry CLI ────────────────────────────────────────────────────────────────
.sentryclirc

# ── Misc generated ────────────────────────────────────────────────────────────
types/database.ts.backup
*.local

# ── IDE (uncomment if your team uses them) ───────────────────────────────────
# .idea/
# .vscode/
