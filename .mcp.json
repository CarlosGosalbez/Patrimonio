        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "c:\\Users\\Carlos\\WebstormProjects\\Patrimio"
      ]
    }
  }
}
